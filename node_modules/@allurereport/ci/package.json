{
  "name": "@allurereport/ci",
  "version": "3.22.1",
  "description": "Utilities set to get useful report data from different CI",
  "keywords": [
    "allure",
    "html",
    "plugin",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./report-context": "./dist/reportContext.js",
    "./report-markdown": "./dist/reportMarkdown.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/core-api": "3.22.1",
    "@allurereport/plugin-api": "3.22.1",
    "axios": "^1.20.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@allurereport/common-config": "3.22.1",
    "@types/node": "^20",
    "@vitest/coverage-istanbul": "5.0.4",
    "@vitest/runner": "^2",
    "@vitest/snapshot": "5.0.4",
    "allure-js-commons": "^3",
    "allure-vitest": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "vitest": "5.0.4"
  }
}