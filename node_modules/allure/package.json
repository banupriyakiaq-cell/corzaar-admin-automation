{
  "name": "allure",
  "version": "3.22.1",
  "description": "Allure Commandline Tool",
  "keywords": [
    "allure",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "bin": "./cli.js",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./rules": "./dist/rules.js",
    "./qualityGate": "./dist/qualityGate.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "start": "node ./cli.js",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/charts-api": "3.22.1",
    "@allurereport/ci": "3.22.1",
    "@allurereport/cli-commons": "3.22.1",
    "@allurereport/core": "3.22.1",
    "@allurereport/core-api": "3.22.1",
    "@allurereport/directory-watcher": "3.22.1",
    "@allurereport/plugin-agent": "3.22.1",
    "@allurereport/plugin-allure2": "3.22.1",
    "@allurereport/plugin-api": "3.22.1",
    "@allurereport/plugin-awesome": "3.22.1",
    "@allurereport/plugin-classic": "3.22.1",
    "@allurereport/plugin-csv": "3.22.1",
    "@allurereport/plugin-dashboard": "3.22.1",
    "@allurereport/plugin-jira": "3.22.1",
    "@allurereport/plugin-log": "3.22.1",
    "@allurereport/plugin-metrics": "3.22.1",
    "@allurereport/plugin-progress": "3.22.1",
    "@allurereport/plugin-server-reload": "3.22.1",
    "@allurereport/plugin-slack": "3.22.1",
    "@allurereport/plugin-xray": "3.22.1",
    "@allurereport/reader-api": "3.22.1",
    "@allurereport/service": "3.22.1",
    "@allurereport/static-server": "3.22.1",
    "adm-zip": "0.6.1",
    "clipanion": "^4.0.0-rc.4",
    "glob": "^13.0.6",
    "lodash.omit": "^4.18.0",
    "prompts": "^2.4.2",
    "typanion": "^3.14.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@allurereport/common-config": "3.22.1",
    "@types/adm-zip": "^0",
    "@types/lodash.omit": "^4.5.9",
    "@types/node": "^20",
    "@types/prompts": "^2",
    "@vitest/coverage-istanbul": "5.0.4",
    "@vitest/runner": "^2",
    "@vitest/snapshot": "5.0.4",
    "allure-js-commons": "^3",
    "allure-vitest": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "vitest": "5.0.4"
  }
